# BRIDGE 자동수정 러너 설정 — ~/bridge-autofix/runner.conf 로 복사해서 채운다.
#
# 이 파일에는 토큰이 들어간다. 반드시 chmod 600.

# BRIDGE 백엔드 공개 주소 (끝에 / 없이)
BRIDGE_URL=https://api.bridgespots.com

# 자동수정을 돌릴 보드 ID. 보드 URL의 마지막 조각.
BRIDGE_BOARD_ID=

# 보드 → JIRA 설정 → 자동수정 → "콜백 토큰 발급"으로 받은 값.
# claim · heartbeat · 결과 회신 셋 다 이 토큰 하나를 쓴다.
BRIDGE_TOKEN=

# 이 맥의 식별 이름. 화면에 "러너 연결됨 · <이름>"으로 뜬다.
RUNNER_NAME=mac-unity-01

# Unity Editor로 열어둔 프로젝트 경로. 러너는 여기서만 작업한다.
PROJECT_DIR=/Users/you/GWBM013-auto-battle-project

# 컴파일 검증 전용 클론. Editor가 연 프로젝트와 **반드시 다른 디렉터리**여야 한다 —
# 프로젝트 락은 디렉터리 단위라, 달라야 Editor를 열어둔 채 batchmode를 돌릴 수 있다.
# 이 클론의 Library는 지우지 말 것(warm해야 검증이 몇 분 안에 끝난다).
VERIFY_PROJECT_DIR=/Users/you/GWBM013-verify

# 검증 스크립트. 기본값은 러너 디렉터리에 설치된 것을 쓴다(게임 저장소를 건드리지 않는다).
VERIFY_SCRIPT=/Users/you/bridge-autofix/verify-compile.sh

# 검증 1회 상한(분). autofix-once.sh 쪽 상한(20분)보다 짧아야 한다.
VERIFY_TIMEOUT_MINUTES=12

# Unity 실행 파일. 비워두면 프로젝트의 ProjectVersion.txt에서 버전을 읽어 자동으로 찾는다.
# UNITY_BIN=

# 큐를 물어보는 주기(초). 짧게 잡아도 서버 부하는 미미하지만 20초면 충분하다.
POLL_SECONDS=20

# 로그 보관 위치
LOG_DIR=/Users/you/bridge-autofix/logs

# 회신하지 못한 결과를 쌓아 두는 곳. 폴링 루프가 매 주기 재전송하고 성공하면 지운다.
# 비워 두면 이 경로를 쓴다. 이 디렉터리에 파일이 계속 남아 있으면 BRIDGE에 못 닿고 있는 것이다.
SPOOL_DIR=/Users/you/bridge-autofix/spool

# ── 작업 시작 전 정리 ──────────────────────────
#
# 러너는 매 건을 같은 출발선에서 시작한다 — 추적 파일은 origin의 기준 브랜치 그대로,
# 추적되지 않는 잔재는 없음. 이 동작 자체는 끌 수 없다(꺼 두면 이전 실행이 죽은 흔적이
# 다음 작업의 PR에 섞여 들어간다). 아래는 정리하며 남기는 것들의 보관 기간이다.
#
# ⚠️ 지우기 전에 추적 파일의 수정은 stash로 건져 두지만, ignore되지 않은 untracked 파일은
#    복구되지 않는다. 이 맥에서 손으로 작업할 때는 반드시 커밋하거나 다른 클론에서 할 것.
#    (Library·Temp·obj 는 건드리지 않는다. 지우면 다음 임포트에 수십 분이 든다.)

# 지난 작업의 로컬 autofix/* 브랜치를 며칠 뒤에 지울지. push된 것은 원격에 남아 있다.
AUTOFIX_BRANCH_KEEP_DAYS=7

# 잔재를 건져 둔 autofix-rescue stash를 몇 개까지 남길지. 사람이 만든 stash는 세지 않는다.
AUTOFIX_RESCUE_STASH_KEEP=5

# Claude Code 헤드리스 실행용 키
ANTHROPIC_API_KEY=

# ── 로케일 테이블 예외 (기본 꺼짐) ─────────────
#
# 자동수정은 원칙적으로 코드만 고치고 .asset은 건드리지 않는다. 하지만 문구 이슈의 상당수는
# 코드가 아니라 테이블의 번역값 자체가 틀린 건이라, 이 경로가 닫혀 있으면 자동수정이 닿지 못한다.
#
# 아래에 로케일 테이블 경로를 지정하면 그 파일에 한해 **이미 존재하는 항목의 m_Localized 값만**
# 고칠 수 있게 열린다. 항목 추가·삭제·재정렬, 새 키 생성은 여전히 전부 막힌다 — 러너가 diff를
# 검사해 하나라도 어긋나면 PR을 만들지 않고 실패로 끝낸다.
#
# 비워 두면 기능은 꺼진 것이고 동작은 종전과 완전히 같다.
#
# 형식: 콜론(:)으로 구분한 glob 목록. 경로는 저장소 루트 기준(git status가 내는 그대로).
# 실제 경로는 대상 저장소에서 확인해 채운다:
#   git ls-files '*.asset' | grep -iE 'local|locale|string.?table'
#
# LOCALE_ASSET_PATHS=Assets/*/Localization/*.asset:Assets/*/Localization/**/*.asset

# 한 작업에서 바꿀 수 있는 번역값 줄 수 상한. 넘으면 실패로 끝낸다.
# 용어 통일처럼 테이블을 훑어야 하는 건은 자동수정의 몫이 아니라는 선이다.
LOCALE_MAX_CHANGED_VALUES=6

# ── 로케일 원본이 저장소 밖에 있을 때 ─────────
#
# ⚠️ 로케일 테이블의 원본이 구글 시트 등 저장소 밖에 있으면 반드시 주소를 넣는다.
#
# 테이블이 시트에서 익스포트되는 파이프라인이면 .asset 수정은 다음 익스포트에 덮어쓰인다.
# PR은 초록불로 머지되고 며칠 뒤 조용히 되돌아간다 — 고쳤다고 믿게 만들고 실제로는 안 고친,
# 자동수정이 만들 수 있는 가장 나쁜 결과다. 러너는 시트에 닿을 수 없어 막을 방법이 없으므로,
# 대신 이 주소를 프롬프트와 PR 본문 양쪽에 실어 사람이 반드시 보게 한다.
#
# 이 값은 위 LOCALE_ASSET_PATHS와 **독립적으로 동작한다.** 예외를 켜지 않아도 실린다 —
# 오히려 시트가 정본이면 LOCALE_ASSET_PATHS는 켜지 않는 쪽이 낫고(어차피 사람이 시트를 고쳐야
# 완결된다), 그 선택을 한 저장소일수록 이 안내가 더 필요하다. 이 값만 채우면 값이 틀린 건에서
# 에이전트는 아무것도 고치지 않고 "원본의 이 항목을 이렇게 바꿔라"는 보고만 남기고 끝낸다.
# 그 보고는 결과 회신의 log_excerpt에 실려 도크의 "에이전트 로그"에 그대로 뜬다.
#
# LOCALE_SOURCE_URL=https://docs.google.com/spreadsheets/d/.../edit

# 원본에서 내려받은 사본의 경로. 저장소 루트 기준 상대경로 또는 절대경로.
#
# 로케일 .asset은 값이 \uXXXX라 한글 문구로 grep하면 0건이다. 그래서 에이전트는 키와 m_Id를
# 징검다리 삼아 돌아가야 하는데, 이스케이프되지 않은 사본이 있으면 증상 문구에서 키를 한 번에
# 역추적할 수 있다 — 보고의 정확도가 여기서 갈린다. 에이전트에게 읽기 전용으로만 안내한다.
# 경로에 파일이 없으면 안내를 생략하고 러너 로그에 경고를 남긴다.
#
# 두 가지 중 하나를 고른다:
#
#  (a) 저장소에 커밋된 익스포트 산출물 — 준비물이 없지만 익스포트 시점 스냅샷이라 시트보다 낡다.
#      LOCALE_SOURCE_MIRROR=Assets/OriginalSpecLanguage.json
#
#  (b) 시트에서 직접 뜬 스냅샷 — 정본 최신값이고 탭 구분까지 들어간다. 만드는 법은
#      build-locale-mirror.py 의 주석 참조(로그인된 크롬이 있는 대화형 세션에서 CSV를 받아
#      이 스크립트로 합친다. 러너는 시트에 인증할 수 없어 스스로 갱신하지 못한다).
#      LOCALE_SOURCE_MIRROR=/Users/<user>/bridge-autofix/locale/locale-sheet.tsv
#
# ⚠️ 절대경로를 쓸 때는 **전용 하위 폴더**에 둘 것. 러너가 그 파일의 상위 폴더를 통째로
#    에이전트에게 열어주기 때문에(--add-dir), runner.conf 와 같은 폴더에 두면 BRIDGE_TOKEN이
#    에이전트에게 노출된다. 러너가 이 경우를 감지하면 작업을 시작하지 않고 실패시킨다.
