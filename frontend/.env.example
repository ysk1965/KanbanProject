# BRIDGE frontend — Vite 빌드 타임 환경 변수
# 복사해서 .env.local 로 쓰고, 실제 값은 커밋하지 않는다. (.env*.local 은 gitignore)
# 코드에서 읽는 모든 VITE_* 변수를 여기 나열한다. 파생 상수는 src/app/config/env.ts 참고.

# ----- API -----
# REST API 베이스 URL. `/api/v1` 로 끝나야 하며, 미설정 시 http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
# S3 직접 URL 을 리라이트할 CloudFront 도메인(호스트만, 예: dxxxx.cloudfront.net). 비우면 리라이트 안 함
VITE_CLOUDFRONT_DOMAIN=

# ----- Google OAuth -----
# Google 로그인 클라이언트 ID. 비우면 Google 로그인 버튼이 비활성화된다
VITE_GOOGLE_CLIENT_ID=

# ----- Firebase (FCM 웹 푸시) -----
# Firebase 콘솔 > 프로젝트 설정 > 웹 앱 구성 값
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics 측정 ID (선택)
VITE_FIREBASE_MEASUREMENT_ID=

# ----- Sentry -----
# Sentry DSN. 비우면 Sentry 를 초기화하지 않고 자체 백엔드(/public/client-errors)로 에러를 보고한다
VITE_SENTRY_DSN=
# Sentry environment 태그 (예: local / dev / prod)
VITE_SENTRY_ENVIRONMENT=
# Sentry release 식별자 (CI 에서 커밋 해시 등으로 주입)
VITE_SENTRY_RELEASE=
