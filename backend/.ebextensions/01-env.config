option_settings:
  # Java options
  aws:elasticbeanstalk:application:environment:
    JAVA_TOOL_OPTIONS: "-Dfile.encoding=UTF-8"
    SERVER_PORT: "5000"

  # Health check
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /actuator/health

  # Deployment policy (DeploymentPolicy/BatchSizeType/BatchSize) 는 여기서 설정하지 않는다.
  # Terraform modules/elastic-beanstalk/main.tf 의 RollingWithAdditionalBatch 가 source of truth 이며,
  # 여기에 Rolling 50% 를 두면 번들마다 정책이 덮어써져 Terraform 과 충돌한다.

  # Rolling update
  aws:autoscaling:updatepolicy:rollingupdate:
    RollingUpdateEnabled: true
    RollingUpdateType: Health

  # Cloudwatch logs
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 30
