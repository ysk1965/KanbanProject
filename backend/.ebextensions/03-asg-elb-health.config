# ASG 가 ALB 헬스체크 결과로 인스턴스를 교체하게 한다.
# 기본값(EC2)은 OS 가 살아 있으면 Healthy 로 봐서, JVM 이 OOM 으로 응답을 못 해도 좀비로 남는다.
# 유예 600초: Spring Boot 기동 + ALB HealthyThreshold(30s x 3) 를 넉넉히 덮는다.
Resources:
  AWSEBAutoScalingGroup:
    Type: "AWS::AutoScaling::AutoScalingGroup"
    Properties:
      HealthCheckType: ELB
      HealthCheckGracePeriod: 600
